rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /mods/{modId} {
      // Tout le monde peut lire et incrémenter le nombre de téléchargements
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']);
      
      // Seuls les administrateurs connectés peuvent créer/modifier/supprimer
      allow write: if request.auth != null;
    }
  }
}
